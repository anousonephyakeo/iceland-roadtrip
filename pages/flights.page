pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: accent-bar
    elementType: shape
    shapeName: rect
    bounds: [60, 30, 40, 4]
    fill:
      type: solid
      color: "$accent"
  - elementId: page-title
    elementType: text
    bounds: [60, 50, 500, 50]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>FLIGHT SCHEDULE</p>
  - elementId: card1-bg
    elementType: shape
    shapeName: rect
    bounds: [80, 130, 540, 230]
    fill:
      type: solid
      color: "$light"
  - elementId: card1-accent
    elementType: shape
    shapeName: rect
    bounds: [80, 130, 540, 4]
    fill:
      type: solid
      color: "$accent"
  - elementId: card1-date
    elementType: text
    bounds: [110, 155, 200, 28]
    content:
      fontSize: 16
      color: "$accent"
      fontFamily: "Oranienbaum"
      letterSpacing: 2
      align: [left, middle]
      wrap: false
      text: |
        <p>MAY 23</p>
  - elementId: card1-route
    elementType: text
    bounds: [110, 195, 480, 40]
    content:
      fontSize: 28
      color: "$primary"
      fontFamily: "Oranienbaum"
      letterSpacing: 1
      align: [left, middle]
      wrap: false
      text: |
        <p>BUDAPEST → MILAN</p>
  - elementId: card1-time
    elementType: text
    bounds: [110, 250, 480, 80]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>7:40 PM – 9:25 PM</p>
        <p><span style="font-size:14px; color:$secondary;">FRIDAY, 23 MAY</span></p>
  - elementId: card2-bg
    elementType: shape
    shapeName: rect
    bounds: [660, 130, 540, 230]
    fill:
      type: solid
      color: "$light"
  - elementId: card2-accent
    elementType: shape
    shapeName: rect
    bounds: [660, 130, 540, 4]
    fill:
      type: solid
      color: "$accent"
  - elementId: card2-date
