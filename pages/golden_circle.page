pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: accent-bar
    elementType: shape
    shapeName: rect
    bounds: [60, 30, 40, 4]
    fill:
      type: solid
      color: "$accent"
  - elementId: page-title
    elementType: text
    bounds: [60, 50, 700, 50]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>GOLDEN CIRCLE — MAY 25</p>
  - elementId: timeline-line
    elementType: shape
    shapeName: straightConnector1
    bounds: [95, 140, 0, 450]
    border:
      style: solid
      width: 2
      color: "$accent"
  - elementId: dot1
    elementType: shape
    shapeName: ellipse
    bounds: [89, 144, 12, 12]
    fill:
      type: solid
      color: "$accent"
  - elementId: item1
    elementType: text
    bounds: [120, 135, 540, 55]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.4
      align: [left, top]
      text: |
        <p><strong><span style="color:$accent;">7:00 AM</span> — Leave Reykjavik</strong></p>
        <p>Before 9 AM tour buses — have every place to yourselves</p>
