pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: accent-bar
    elementType: shape
    shapeName: rect
    bounds: [60, 30, 40, 4]
    fill:
      type: solid
      color: "$accent"
  - elementId: page-title
    elementType: text
    bounds: [60, 50, 700, 50]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>TIPS, APPS & WARNINGS</p>
  - elementId: apps-label
    elementType: text
    bounds: [60, 110, 300, 28]
    content:
      fontSize: 16
      color: "$accent"
      fontFamily: "Oranienbaum"
      letterSpacing: 2
      align: [left, middle]
      wrap: false
      text: |
        <p>APPS TO DOWNLOAD</p>
  - elementId: app1-bg
    elementType: shape
    shapeName: rect
    bounds: [60, 150, 270, 140]
    fill:
      type: solid
      color: "$light"
  - elementId: app1-icon
    elementType: icon
    bounds: [171, 162, 48, 48]
    iconName: "fas:mobile-screen-button"
    fill:
      type: solid
      color: "$accent"
  - elementId: app1-name
    elementType: text
    bounds: [75, 220, 240, 28]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "QuattrocentoSans"
      align: [center, middle]
      wrap: false
      text: |
        <p><strong>PARKA</strong></p>
  - elementId: app1-desc
    elementType: text
    bounds: [75, 252, 240, 28]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.3
      align: [center, middle]
      wrap: false
      text: |
        <p>Parking at Geysir & South Coast</p>
  - elementId: app2-bg
    elementType: shape
    shapeName: rect
    bounds: [350, 150, 270, 140]
    fill:
      type: solid
      color: "$light"
  - elementId: app2-icon
    elementType: icon
    bounds: [461, 162, 48, 48]
    iconName: "fas:ticket"
    fill:
      type: solid
      color: "$accent"
  - elementId: app2-name
    elementType: text
    bounds: [365, 220, 240, 28]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "QuattrocentoSans"
      align: [center, middle]
      wrap: false
      text: |
        <p><strong>CHECKIT.IS</strong></p>
  - elementId: app2-desc
    elementType: text
    bounds: [365, 252, 240, 28]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.3
      align: [center, middle]
      wrap: false
      text: |
        <p>Thingvellir parking</p>
  - elementId: app3-bg
